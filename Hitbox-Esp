local function createFakeHead(player)
    if not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    if swappedHeads[player] then return end
    swappedHeads[player] = {OriginalHead = head, OriginalName = head.Name, Parent = head.Parent}
    head.Name = "Vortex_OriginalHead"
    local fake = Instance.new("Part")
    fake.Name = "Head"
    fake.Size = Vector3.new(Config.HeadSize, Config.HeadSize, Config.HeadSize)
    fake.CFrame = head.CFrame
    fake.CanCollide = false
    fake.Anchored = false
    fake.Massless = true
    fake.Locked = true
    fake.Transparency = 0
    fake.Material = Enum.Material.Neon
    fake.BrickColor = BrickColor.new("Really red")
    fake.Parent = player.Character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = fake
    weld.Part1 = head
    weld.Parent = fake
    local headMesh = head:FindFirstChildOfClass("SpecialMesh")
    if headMesh then
        local copyMesh = headMesh:Clone()
        copyMesh.Parent = fake
    end
    fake:SetAttribute("VortexFakeHead", true)
end

local function restoreHead(player)
    local data = swappedHeads[player]
    if not data then return end
    if data.OriginalHead and data.OriginalHead.Parent then
        data.OriginalHead.Name = data.OriginalName or "Head"
    end
    if player.Character then
        for _, part in ipairs(player.Character:GetChildren()) do
            if part:IsA("BasePart") and part:GetAttribute("VortexFakeHead") then
                part:Destroy()
            end
        end
    end
    swappedHeads[player] = nil
end

local function UpdateHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
                restoreHead(player)
            else
                if Config.HeadSolid then
                    if not swappedHeads[player] then
                        swap = pcall(function() createFakeHead(player) end)
                    end
                    local fake = nil
                    for _, part in ipairs(player.Character:GetChildren()) do
                        if part:IsA("BasePart") and part:GetAttribute("VortexFakeHead") then fake = part break end
                    end
                    if fake then
                        fake.Size = Vector3.new(Config.HeadSize, Config.HeadSize, Config.HeadSize)
                        fake.Transparency = 0
                        fake.Material = Enum.Material.Neon
                        fake.BrickColor = BrickColor.new("Really red")
                        fake.CanCollide = false
                        local orig = player.Character:FindFirstChild("Vortex_OriginalHead")
                        if orig then orig.Transparency = 1 end
                    end
                else
                    if swappedHeads[player] then restoreHead(player) end
                    local head = player.Character:FindFirstChild("Head")
                    if head then
                        pcall(function()
                            head.Size = Vector3.new(Config.HeadSize, Config.HeadSize, Config.HeadSize)
                            head.Transparency = Config.HeadTransparency
                            head.BrickColor = BrickColor.new("Really red")
                            head.Material = Enum.Material.Neon
                            head.CanCollide = false
                            head.Massless = true
                        end)
                    end
                end
            end
        end
    end
end

local HbeConnection
local function StartHBE()
    if HbeConnection then HbeConnection:Disconnect() end
    HbeConnection = RunService.RenderStepped:Connect(function()
        if Config.HbeEnabled then
            pcall(UpdateHitboxes)
        end
    end)
end

local function StopHBE()
    if HbeConnection then HbeConnection:Disconnect(); HbeConnection = nil end
    for _, player in ipairs(Players:GetPlayers()) do
        restoreHead(player)
        if player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                pcall(function()
                    head.Size = Vector3.new(2,1,1)
                    head.Transparency = 0
                    head.BrickColor = BrickColor.new("Bright yellow")
                    head.Material = Enum.Material.Plastic
                    head.CanCollide = true
                end)
            end
        end
    end
end

local function CreateESP(player)
    if ESPObjects[player] then return end
    local espFolder = Instance.new("Folder")
    espFolder.Name = "VortexESP"
    ESPObjects[player] = espFolder
    if player.Character then
        local head = player.Character:FindFirstChild("Head")
        local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
        if head and humanoidRootPart then
            if Config.EspHighlight then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight"
                highlight.FillColor = Color3.fromRGB(255,0,0)
                highlight.OutlineColor = Color3.fromRGB(255,255,255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Parent = espFolder
                highlight.Adornee = player.Character
            end
            if Config.EspNameTags then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ESP_Name"
                billboard.Size = UDim2.new(0,120,0,24)
                billboard.StudsOffset = Vector3.new(0,2.5,0)
                billboard.AlwaysOnTop = true
                billboard.Adornee = head
                billboard.Parent = espFolder
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1,0,1,0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = player.Name
                nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
                nameLabel.Font = Enum.Font.Gotham
                nameLabel.TextSize = 12
                nameLabel.Parent = billboard
            end
            if Config.EspDistance then
                local distanceBillboard = Instance.new("BillboardGui")
                distanceBillboard.Name = "ESP_Distance"
                distanceBillboard.Size = UDim2.new(0,100,0,20)
                distanceBillboard.StudsOffset = Vector3.new(0,1.2,0)
                distanceBillboard.AlwaysOnTop = true
                distanceBillboard.Adornee = head
                distanceBillboard.Parent = espFolder
                local distanceLabel = Instance.new("TextLabel")
                distanceLabel.Size = UDim2.new(1,0,1,0)
                distanceLabel.BackgroundTransparency = 1
                distanceLabel.TextColor3 = Color3.fromRGB(0,255,255)
                distanceLabel.TextStrokeTransparency = 0
                distanceLabel.TextSize = 11
                distanceLabel.Font = Enum.Font.Gotham
                distanceLabel.Parent = distanceBillboard
            end
            espFolder.Parent = player.Character
        end
    end
end

local function UpdateESP()
    for player, espFolder in pairs(ESPObjects) do
        if player.Character and espFolder.Parent == nil then espFolder.Parent = player.Character end
        if Config.EspDistance then
            local distanceBillboard = espFolder:FindFirstChild("ESP_Distance")
            if distanceBillboard and localPlayer.Character then
                local localRoot = localPlayer.Character:FindFirstChild("HumanoidRootPart")
                local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if localRoot and playerRoot then
                    local distance = (localRoot.Position - playerRoot.Position).Magnitude
                    local distanceLabel = distanceBillboard:FindFirstChildOfClass("TextLabel")
                    if distanceLabel then distanceLabel.Text = string.format("[%d studs]", math.floor(distance)) end
                end
            end
        end
    end
end

local function RemoveESP(player)
    if ESPObjects[player] then
        ESPObjects[player]:Destroy()
        ESPObjects[player] = nil
    end
end

local function CleanupESP()
    for player, espFolder in pairs(ESPObjects) do
        if not player:IsDescendantOf(Players) then RemoveESP(player) end
    end
end

local function RefreshESP()
    for p in pairs(ESPObjects) do RemoveESP(p) end
    if Config.EspEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then CreateESP(p) end
        end
    end
end

local EspConnection
local function StartESP()
    if EspConnection then EspConnection:Disconnect() end
    for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer then CreateESP(p) end end
    EspConnection = RunService.RenderStepped:Connect(function()
        if Config.EspEnabled then
            pcall(UpdateESP)
            pcall(CleanupESP)
        end
    end)
end

local function StopESP()
    if EspConnection then EspConnection:Disconnect(); EspConnection = nil end
    for p in pairs(ESPObjects) do RemoveESP(p) end
end

local function OnPlayerCharacterAdded(player)
    if Config.EspEnabled then wait(0.5); CreateESP(player) end
end

local function PlayerAdded(player)
    player.CharacterAdded:Connect(function() OnPlayerCharacterAdded(player) end)
end

local function PlayerRemoving(player)
    RemoveESP(player)
    restoreHead(player)
end

