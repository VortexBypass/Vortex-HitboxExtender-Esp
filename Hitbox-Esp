    if Config.HeadSolid then HeadSolidToggle.BackgroundColor3 = Color3.fromRGB(10,80,10); HeadSolidToggle.Text = "ON" else HeadSolidToggle.BackgroundColor3 = Color3.fromRGB(50,6,6); HeadSolidToggle.Text = "OFF" end
    if Config.HbeEnabled then pcall(UpdateHitboxes) end
end)

HeadSizeBox.FocusLost:Connect(function()
    local n = tonumber(HeadSizeBox.Text)
    if n and n>=1 and n<=50 then Config.HeadSize = n; HeadSizeBox.Text = tostring(n); if Config.HbeEnabled then pcall(UpdateHitboxes) end else HeadSizeBox.Text = tostring(Config.HeadSize) end
end)

TransparencyBox.FocusLost:Connect(function()
    local n = tonumber(TransparencyBox.Text)
    if n and n>=0 and n<=1 then Config.HeadTransparency = n; TransparencyBox.Text = string.format("%.2f",n); if Config.HbeEnabled then pcall(UpdateHitboxes) end else TransparencyBox.Text = string.format("%.2f",Config.HeadTransparency) end
end)

CloseButton.MouseButton1Click:Connect(function() CloseGUI() end)

FloatingIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        FloatingIconDragging = true
        dragInput = input
        dragStart = input.Position
        startPos = FloatingIcon.Position
        dragMoved = false
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                if not dragMoved then
                    OpenGUI()
                end
                FloatingIconDragging = false
                dragInput, dragStart, startPos, dragMoved = nil, nil, nil, false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragInput and input == dragInput then
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then dragMoved = true end
        if FloatingIconDragging then
            local startX = startPos.X.Offset
            local startY = startPos.Y.Offset
            local newX = startX + delta.X
            local newY = startY + delta.Y
            local viewport = workspaceCamera and workspaceCamera.ViewportSize or Vector2.new(1280,720)
            local iconSize = FloatingIcon.AbsoluteSize
            newX = math.clamp(newX, 0, math.max(0, viewport.X - iconSize.X))
            newY = math.clamp(newY, 0, math.max(0, viewport.Y - iconSize.Y))
            FloatingIcon.Position = UDim2.new(0, newX, 0, newY)
        end
    end
end)

FloatingIcon.MouseButton1Click:Connect(function()
    wait(0.06)
    if not FloatingIconDragging then OpenGUI() end
end)

MainFrame.Visible = true
FloatingIcon.Visible = false

StopHBE()
StopESP()
SwitchTab("HBE")
