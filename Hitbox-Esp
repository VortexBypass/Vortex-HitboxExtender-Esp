local function tweenObject(object, props, time, style, dir, onComplete)
    local ti = TweenService:Create(object, TweenInfo.new(time or 0.28, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.Out), props)
    ti:Play()
    if onComplete then
        ti.Completed:Connect(onComplete)
    end
    return ti
end

